# LOKHA Environment Configuration
# All frontend environment variables must start with VITE_

# Map and Geocoding APIs (Open-source / Free tier)
VITE_MAP_PROVIDER=openstreetmap
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Future Backend & Auth (Firebase / Supabase ready architecture)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Analytics & Monitoring Stubs
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_SENTRY_DSN=
